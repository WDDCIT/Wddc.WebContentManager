@{
    ViewBag.Title = "Clearance Sale";
}

@section Styles {
    <link href="https://kendo.cdn.telerik.com/2021.2.511/styles/kendo.bootstrap-v4.min.css" rel="stylesheet" type="text/css" />
}

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.18.1/moment.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.11.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <script src="https://kendo.cdn.telerik.com/2021.2.511/js/kendo.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        var clearanceDataSource, salesGrid;
        var isLogVisible = false;
        var activityLogGrid;
        var editingOriginalItemNumber = "";
        var importPreview = null;

        function showNotification(type, message) {
            Swal.fire({
                icon: type,
                title: type === 'success' ? 'Success!' : (type === 'info' ? 'Note' : 'Error'),
                text: message,
                confirmButtonColor: '#3182ce',
                timer: type === 'success' ? 3000 : undefined,
                timerProgressBar: type === 'success',
                showConfirmButton: true,
                confirmButtonText: 'OK'
            });
        }

        function categoryName(id) {
            if (id === 1 || id === "1") return "Retail Clearance";
            if (id === 2 || id === "2") return "Equipment Clearance";
            return "";
        }

        function money(value) {
            if (value === null || value === undefined || value === "") return "—";
            return "$" + kendo.toString(Number(value), "n2");
        }

        function esc(value) {
            return kendo.htmlEncode(value === null || value === undefined ? "" : String(value));
        }

        /* =================== Data check =================== */

        var activeIssue = null;

        /* How pricing actually works on the ordering website:
             "Reg Price"  = Web_Clearance.regular_price   (the was-price you set here)
             "Sale Price" = the item's CURRENT CATALOG PRICE (set by pricing, not here)
           The Web_Clearance.sale_price column is not used by the website at all. */

        var ISSUE_INFO = {
            notincatalog: { label: 'are NOT in the WDDC web catalog', why: '<strong>customers cannot see them</strong> — the website only lists clearance items that exist in the catalog, so these are on the list but invisible. Remove them, or have the item added to the catalog', attention: true },
            nodiscount: { label: 'show NO saving to the customer', why: 'the Reg Price is not higher than the current selling price, so the website shows the same number twice. Raise the Reg Price to the true "was" price', attention: true },
            noregular: { label: 'have no Reg Price', why: 'there is no "was" price for the website to show against the sale price', attention: true },
            hugediscount: { label: 'show a discount over 75%', why: 'unusually deep — worth confirming the Reg Price is not a typo', attention: false }
        };

        function computeIssues(r) {
            var issues = [];
            if (!r.InCatalog) issues.push('notincatalog');
            var reg = r.regular_price, live = r.CatalogPrice;
            if (reg === null || reg === undefined || reg === 0) issues.push('noregular');
            else if (live !== null && live !== undefined) {
                if (reg <= live) issues.push('nodiscount');
                else if ((reg - live) / reg > 0.75) issues.push('hugediscount');
            }
            return issues.join(',');
        }

        function discountPct(r) {
            var reg = r.regular_price, live = r.CatalogPrice;
            if (reg === null || reg === undefined || reg === 0) return null;
            if (live === null || live === undefined) return null;
            return (reg - live) / reg * 100;
        }

        function renderDataCheck() {
            var data = clearanceDataSource.data();
            var counts = { notincatalog: 0, nodiscount: 0, noregular: 0, hugediscount: 0 };
            for (var i = 0; i < data.length; i++) {
                (data[i].Issues || '').split(',').forEach(function (code) {
                    if (counts.hasOwnProperty(code)) counts[code]++;
                });
            }
            var attention = counts.notincatalog + counts.nodiscount + counts.noregular;
            var panel = $('#dataCheck');
            if (attention === 0 && counts.hugediscount === 0) { panel.hide().empty(); return; }

            var html = '<div class="dc-header ' + (attention > 0 ? 'dc-warn' : 'dc-info') + '">'
                + '<i class="fa ' + (attention > 0 ? 'fa-exclamation-triangle' : 'fa-info-circle') + '"></i> '
                + '<strong>Data check:</strong> '
                + (attention > 0 ? attention + ' item(s) need attention' : 'no problems — one note below')
                + (activeIssue ? ' <button type="button" class="dc-clear" onclick="setIssueFilter(null)"><i class="fa fa-times"></i> Show all items</button>' : '')
                + '</div><ul class="dc-list">';
            ['notincatalog', 'nodiscount', 'noregular', 'hugediscount'].forEach(function (code) {
                if (!counts[code]) return;
                var info = ISSUE_INFO[code];
                html += '<li class="' + (info.attention ? 'dc-item-warn' : 'dc-item-info') + '">'
                    + '<strong>' + counts[code] + '</strong> item(s) ' + info.label + ' — ' + info.why + ' '
                    + '<button type="button" class="dc-show' + (activeIssue === code ? ' dc-show-active' : '') + '" onclick="setIssueFilter(\'' + code + '\')">'
                    + (activeIssue === code ? '<i class="fa fa-check"></i> Showing' : 'Show') + '</button></li>';
            });
            html += '</ul>';
            panel.html(html).show();
        }

        function setIssueFilter(code) {
            activeIssue = (activeIssue === code || code === null) ? null : code;
            applyGridFilters();
            renderDataCheck();
        }

        /* Remove clauses for the fields we own, keep any other column filters the user set */
        function stripFields(filter, fields) {
            if (!filter) return null;
            if (filter.filters) {
                var kept = filter.filters.map(function (f) { return stripFields(f, fields); }).filter(Boolean);
                return kept.length ? { logic: filter.logic, filters: kept } : null;
            }
            return fields.indexOf(filter.field) >= 0 ? null : filter;
        }

        function applyGridFilters() {
            var existing = stripFields(clearanceDataSource.filter(), ['CategoryID', 'Issues']);
            var filters = existing ? [existing] : [];
            var retail = $('#catRetail').prop('checked');
            var equipment = $('#catEquipment').prop('checked');
            if (retail !== equipment)
                filters.push({ field: 'CategoryID', operator: 'eq', value: retail ? 1 : 2 });
            if (activeIssue)
                filters.push({ field: 'Issues', operator: 'contains', value: activeIssue });
            clearanceDataSource.filter(filters.length ? { logic: 'and', filters: filters } : []);
        }

        /* =================== Activity log =================== */

        function toggleLog() {
            isLogVisible = !isLogVisible;
            var container = $('#logContainer');
            var toggleText = $('#logToggleText');

            if (isLogVisible) {
                container.slideDown(300);
                toggleText.text('Hide Activity Log');
                loadActivityLog();
            } else {
                container.slideUp(300);
                toggleText.text('Show Activity Log');
            }
        }

        function loadActivityLog() {
            $.ajax({
                url: '@Url.Action("Log", "ClearanceSale")',
                type: 'GET',
                data: { referrerUrl: 'ClearanceSale', pageNumber: 1, pageSize: 100 },
                success: function (response) {
                    initActivityLogGrid(response && response.Results ? response.Results : []);
                },
                error: function (xhr, status, error) {
                    console.error('Error loading activity log:', error);
                    initActivityLogGrid([]);
                }
            });
        }

        function initActivityLogGrid(logData) {
            if (activityLogGrid) {
                activityLogGrid.destroy();
                $('#gridActivityLog').empty();
            }

            activityLogGrid = $("#gridActivityLog").kendoGrid({
                dataSource: {
                    data: logData,
                    pageSize: 20,
                    schema: {
                        model: {
                            fields: {
                                Text: { type: "string" },
                                User: { type: "string" },
                                Created: { type: "string" }
                            }
                        }
                    }
                },
                height: 400,
                scrollable: true,
                sortable: true,
                pageable: { refresh: true, pageSizes: [10, 20, 50, 100], buttonCount: 5 },
                filterable: { mode: "row" },
                resizable: true,
                columns: [
                    {
                        field: "Text",
                        title: "Log Message",
                        width: "55%",
                        filterable: { cell: { operator: "contains", showOperators: false } },
                        template: function (dataItem) {
                            return '<div style="white-space: pre-wrap; word-wrap: break-word; line-height: 1.5;">' +
                                kendo.htmlEncode(dataItem.Text || '') + '</div>';
                        },
                        attributes: { style: "white-space: normal; word-wrap: break-word;" }
                    },
                    {
                        field: "User",
                        title: "Username",
                        width: "20%",
                        filterable: { cell: { operator: "contains", showOperators: false } },
                        template: function (dataItem) { return dataItem.User || 'Unknown'; }
                    },
                    {
                        field: "Created",
                        title: "Date",
                        width: "25%",
                        filterable: false,
                        template: function (dataItem) { return dataItem.Created || ''; }
                    }
                ]
            }).data("kendoGrid");
        }

        /* =================== Excel import =================== */

        function startImport() {
            $('#importFileInput').val('');
            $('#importFileInput').trigger('click');
        }

        function uploadImportFile(file) {
            var formData = new FormData();
            formData.append('importFile', file);

            Swal.fire({
                title: 'Reading ' + file.name + '…',
                allowOutsideClick: false,
                didOpen: function () { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("UploadImport", "ClearanceSale")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (preview) {
                    Swal.close();
                    importPreview = preview;
                    renderImportReview(preview);
                },
                error: function (xhr) {
                    Swal.close();
                    var message = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Could not read the file.';
                    showNotification('error', message);
                }
            });
        }

        function cancelImport() {
            importPreview = null;
            $('#importReviewCard').slideUp(200);
        }

        function renderImportReview(p) {
            var html = '';

            // --- File summary line
            var newCount = 0, changedCount = 0, unchangedCount = 0;
            p.rows.forEach(function (r) {
                if (r.status === 'new') newCount++;
                else if (r.status === 'changed') changedCount++;
                else unchangedCount++;
            });
            html += '<div class="imp-fileinfo"><i class="fa fa-file-excel-o"></i> <strong>' + esc(p.fileName) + '</strong>'
                + ' &nbsp;·&nbsp; sheet "' + esc(p.sheetName) + '" &nbsp;·&nbsp; ' + p.rows.length + ' item rows read'
                + ' &nbsp;·&nbsp; currently on website: ' + p.currentCount + ' items</div>';

            html += '<div class="imp-chips">'
                + chip('plus', newCount + ' new', 'chip-green')
                + chip('pencil', changedCount + ' changed', 'chip-blue')
                + chip('check', unchangedCount + ' unchanged', 'chip-gray')
                + chip('trash', p.removedItems.length + ' will be removed', p.removedItems.length ? 'chip-red' : 'chip-gray')
                + chip('exclamation-triangle', p.errors.length + ' error rows', p.errors.length ? 'chip-red' : 'chip-gray')
                + '</div>';

            // --- Sheet carries a sale_price column, which the website ignores
            if (p.hasSalePriceColumn) {
                html += noticeBox('warn', '<strong>This sheet has a sale_price column.</strong> The website does not use it — what customers pay is the item\'s current catalog price. ' +
                    'Only <code>regular_price</code> (the "was" price) is controlled from here, so sale_price values will be stored but have no effect.');
            }

            // --- Errors (blocking unless acknowledged)
            if (p.errors.length) {
                html += '<div class="imp-section imp-error"><h5><i class="fa fa-times-circle"></i> ' + p.errors.length + ' row(s) cannot be imported</h5>';
                html += '<table class="imp-table"><tr><th>Excel Row</th><th>Item</th><th>Problem</th></tr>';
                p.errors.forEach(function (e) {
                    html += '<tr><td>' + e.row + '</td><td>' + esc(e.itemNumber) + '</td><td>' + esc(e.messages.join(' ')) + '</td></tr>';
                });
                html += '</table>';
                html += '<label class="imp-check"><input type="checkbox" id="ackErrors" onchange="updateImportSummary()"> Skip these rows and import the rest</label>';
                html += '</div>';
            }

            // --- Category 3 collisions (always skipped)
            var cat3 = p.rows.filter(function (r) { return r.inCategory3; });
            if (cat3.length) {
                html += '<div class="imp-section imp-error"><h5><i class="fa fa-ban"></i> ' + cat3.length + ' item(s) skipped — already in category 3 (Hard to Find Items, managed by IT)</h5>';
                html += '<div class="imp-inline-list">' + cat3.map(function (r) { return esc(r.itemNumber) + ' (row ' + r.row + ')'; }).join(', ') + '</div></div>';
            }

            // --- Duplicates: pick one row per item
            if (p.duplicates.length) {
                var rowByNumber = {};
                p.rows.forEach(function (r) { rowByNumber[r.row] = r; });
                html += '<div class="imp-section imp-warn"><h5><i class="fa fa-clone"></i> ' + p.duplicates.length + ' item(s) appear more than once — choose which row to use</h5>';
                p.duplicates.forEach(function (group, gi) {
                    var first = rowByNumber[group[0]];
                    html += '<div class="imp-dup-group"><div class="imp-dup-title">' + esc(first ? first.itemNumber : '') + '</div>';
                    html += '<table class="imp-table"><tr><th></th><th>Excel Row</th><th>Category</th><th>Reg Price (was)</th></tr>';
                    group.forEach(function (rowNumber, ri) {
                        var r = rowByNumber[rowNumber];
                        if (!r) return;
                        html += '<tr><td><input type="radio" name="dupPick' + gi + '" value="' + rowNumber + '"' + (ri === 0 ? ' checked' : '') + ' onchange="updateImportSummary()"></td>'
                            + '<td>' + rowNumber + '</td><td>' + esc(r.categoryName) + '</td><td>' + money(r.regular_price) + '</td></tr>';
                    });
                    html += '</table></div>';
                });
                html += '</div>';
            }

            // --- Not in web catalog
            var notInCatalog = p.rows.filter(function (r) { return !r.inCatalog && !r.inCategory3; });
            if (notInCatalog.length) {
                html += '<div class="imp-section imp-warn"><h5><i class="fa fa-question-circle"></i> ' + notInCatalog.length + ' item(s) are NOT in the web catalog</h5>'
                    + '<div class="imp-hint"><strong>These will not appear on the website at all</strong> — it only lists clearance items that exist in the catalog. Untick any you do not want to import.</div>';
                html += '<table class="imp-table"><tr><th>Include</th><th>Excel Row</th><th>Item</th><th>Category</th><th>Reg Price (was)</th></tr>';
                notInCatalog.forEach(function (r, i) {
                    html += '<tr><td><input type="checkbox" class="nicInclude" data-row="' + r.row + '" checked onchange="updateImportSummary()"></td>'
                        + '<td>' + r.row + '</td><td>' + esc(r.itemNumber) + '</td><td>' + esc(r.categoryName) + '</td><td>' + money(r.regular_price) + '</td></tr>';
                });
                html += '</table></div>';
            }

            // --- Items on the website that are missing from the sheet
            if (p.removedItems.length) {
                html += '<div class="imp-section imp-remove"><h5><i class="fa fa-trash-o"></i> ' + p.removedItems.length + ' item(s) currently on the website are NOT in this sheet</h5>'
                    + '<div class="imp-hint">They will be <strong>removed from the clearance sale</strong> unless you tick Keep. '
                    + '<a href="javascript:void(0)" onclick="$(\'.keepRemoved\').prop(\'checked\', true); updateImportSummary();">Keep all</a> · '
                    + '<a href="javascript:void(0)" onclick="$(\'.keepRemoved\').prop(\'checked\', false); updateImportSummary();">Remove all</a></div>';
                html += '<table class="imp-table"><tr><th>Keep</th><th>Item</th><th>Description</th><th>Category</th><th>Reg Price (was)</th><th>Sale Price (live)</th></tr>';
                p.removedItems.forEach(function (r, i) {
                    html += '<tr><td><input type="checkbox" class="keepRemoved" data-index="' + i + '" onchange="updateImportSummary()"></td>'
                        + '<td>' + esc(r.itemNumber) + '</td><td class="imp-desc">' + esc(r.catalogDescription || '') + '</td><td>' + esc(r.categoryName) + '</td>'
                        + '<td>' + money(r.regular_price) + '</td><td>' + money(r.catalogPrice) + '</td></tr>';
                });
                html += '</table></div>';
            }

            // --- Row warnings (sale >= regular, expired dates, …)
            var warnRows = p.rows.filter(function (r) { return r.warnings && r.warnings.length; });
            if (warnRows.length) {
                html += '<div class="imp-section imp-warn"><h5><i class="fa fa-exclamation-triangle"></i> ' + warnRows.length + ' warning(s) — check these values</h5>';
                html += '<table class="imp-table"><tr><th>Excel Row</th><th>Item</th><th>Warning</th></tr>';
                warnRows.forEach(function (r) {
                    html += '<tr><td>' + r.row + '</td><td>' + esc(r.itemNumber) + '</td><td>' + esc(r.warnings.join(' ')) + '</td></tr>';
                });
                html += '</table></div>';
            }

            // --- Changed items details (collapsible)
            var changed = p.rows.filter(function (r) { return r.status === 'changed'; });
            if (changed.length) {
                html += '<div class="imp-section"><h5 class="imp-collapse" onclick="$(\'#impChangedBody\').slideToggle(150)"><i class="fa fa-pencil"></i> ' + changed.length + ' item(s) will change <small>(click to show)</small></h5>';
                html += '<div id="impChangedBody" style="display:none"><table class="imp-table"><tr><th>Item</th><th>Description</th><th>Changes</th></tr>';
                changed.forEach(function (r) {
                    html += '<tr><td>' + esc(r.itemNumber) + '</td><td class="imp-desc">' + esc(r.catalogDescription || '') + '</td><td>' + esc(r.changes.join('; ')) + '</td></tr>';
                });
                html += '</table></div></div>';
            }

            // --- New items details (collapsible)
            var added = p.rows.filter(function (r) { return r.status === 'new' && !r.inCategory3; });
            if (added.length) {
                html += '<div class="imp-section"><h5 class="imp-collapse" onclick="$(\'#impNewBody\').slideToggle(150)"><i class="fa fa-plus"></i> ' + added.length + ' new item(s) <small>(click to show)</small></h5>';
                html += '<div id="impNewBody" style="display:none"><table class="imp-table"><tr><th>Item</th><th>Description</th><th>Category</th><th>Reg Price (was)</th><th>Sale Price (live)</th><th>Saves</th></tr>';
                added.forEach(function (r) {
                    var saves = (r.regular_price && r.catalogPrice && r.regular_price > r.catalogPrice)
                        ? ((r.regular_price - r.catalogPrice) / r.regular_price * 100).toFixed(0) + '%'
                        : (r.catalogPrice ? '<span style="color:#c53030">none</span>' : '');
                    html += '<tr><td>' + esc(r.itemNumber) + '</td><td class="imp-desc">' + esc(r.catalogDescription || '') + '</td><td>' + esc(r.categoryName) + '</td><td>' + money(r.regular_price) + '</td><td>' + money(r.catalogPrice) + '</td><td>' + saves + '</td></tr>';
                });
                html += '</table></div></div>';
            }

            $('#importReviewBody').html(html);
            updateImportSummary();
            $('#importReviewCard').slideDown(200);
            $('html, body').animate({ scrollTop: $('#importReviewCard').offset().top - 70 }, 300);
        }

        function chip(icon, text, cls) {
            return '<span class="imp-chip ' + cls + '"><i class="fa fa-' + icon + '"></i> ' + text + '</span>';
        }

        function noticeBox(kind, innerHtml) {
            return '<div class="imp-notice imp-notice-' + kind + '"><i class="fa fa-info-circle"></i> ' + innerHtml + '</div>';
        }

        function buildFinalItems() {
            if (!importPreview) return [];
            var skipRow = {};
            importPreview.duplicates.forEach(function (group, gi) {
                var pick = parseInt($('input[name="dupPick' + gi + '"]:checked').val());
                group.forEach(function (rowNumber) { if (rowNumber !== pick) skipRow[rowNumber] = true; });
            });
            $('.nicInclude').each(function () {
                if (!$(this).prop('checked')) skipRow[parseInt($(this).data('row'))] = true;
            });

            var items = [];
            importPreview.rows.forEach(function (r) {
                if (skipRow[r.row] || r.inCategory3) return;
                items.push({
                    ItemNumber: r.itemNumber,
                    CategoryID: r.categoryID,
                    regular_price: r.regular_price
                });
            });
            $('.keepRemoved').each(function () {
                if ($(this).prop('checked')) {
                    var r = importPreview.removedItems[parseInt($(this).data('index'))];
                    items.push({
                        ItemNumber: r.itemNumber,
                        CategoryID: r.categoryID,
                        regular_price: r.regular_price
                    });
                }
            });
            return items;
        }

        function updateImportSummary() {
            if (!importPreview) return;
            var items = buildFinalItems();
            var kept = $('.keepRemoved:checked').length;
            var removed = importPreview.removedItems.length - kept;
            $('#importSummaryText').html('<strong>' + items.length + '</strong> items will be on the clearance sale · <strong>' + removed + '</strong> removed');

            var blocked = importPreview.errors.length > 0 && !$('#ackErrors').prop('checked');
            $('#btnApplyImport').prop('disabled', blocked || items.length === 0);
            $('#importBlockedHint').toggle(blocked);
        }

        function applyImport() {
            var items = buildFinalItems();
            var kept = $('.keepRemoved:checked').length;
            var removed = importPreview.removedItems.length - kept;

            Swal.fire({
                title: 'Replace the clearance sale?',
                html: 'The website will show <strong>' + items.length + '</strong> Retail &amp; Equipment clearance items.<br>' +
                    (removed > 0 ? '<strong>' + removed + '</strong> item(s) will be removed.<br>' : '') +
                    '<small>A backup of the current list is saved automatically — you can undo this import.</small>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3182ce',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, import now',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                Swal.fire({ title: 'Importing…', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                $.ajax({
                    url: '@Url.Action("ConfirmImport", "ClearanceSale")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ fileName: importPreview.fileName, items: items }),
                    success: function (result) {
                        cancelImport();
                        salesGrid.dataSource.read();
                        if (isLogVisible) loadActivityLog();
                        Swal.fire({
                            icon: 'success',
                            title: 'Import complete',
                            html: '<strong>' + result.rowsInserted + '</strong> items are now on the clearance sale.<br>' +
                                '<small>The previous list (' + result.rowsBackedUp + ' items) was saved automatically —<br>' +
                                'use "Undo Last Import" if something looks wrong.</small>',
                            confirmButtonColor: '#3182ce'
                        });
                    },
                    error: function (xhr) {
                        var message = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Import failed.';
                        Swal.fire({ icon: 'error', title: 'Import failed — no changes were made', text: message, confirmButtonColor: '#3182ce' });
                    }
                });
            });
        }

        /* =================== Undo last import =================== */

        function undoLastImport() {
            $.getJSON('@Url.Action("GetBackups", "ClearanceSale")', function (backups) {
                if (!backups || !backups.length) {
                    showNotification('info', 'There is no backup to restore yet.');
                    return;
                }
                var last = backups[0];
                Swal.fire({
                    title: 'Undo last import?',
                    html: 'This restores the clearance sale to how it was on<br><strong>' + last.backupDate + '</strong>' +
                        (last.backupBy ? ' (' + esc(last.backupBy) + ')' : '') + '<br>' +
                        '<small>' + last.rowCount + ' items</small>',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e53e3e',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, restore it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    Swal.fire({ title: 'Restoring…', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                    $.ajax({
                        url: '@Url.Action("RestoreBackup", "ClearanceSale")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ backupTableName: last.tableName }),
                        success: function (result) {
                            salesGrid.dataSource.read();
                            if (isLogVisible) loadActivityLog();
                            Swal.fire({
                                icon: 'success',
                                title: 'Restored',
                                html: '<strong>' + result.rowsRestored + '</strong> items restored.',
                                confirmButtonColor: '#3182ce'
                            });
                        },
                        error: function (xhr) {
                            var message = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Restore failed.';
                            Swal.fire({ icon: 'error', title: 'Restore failed', text: message, confirmButtonColor: '#3182ce' });
                        }
                    });
                });
            });
        }

        /* =================== Grid =================== */

        $(document).ready(function () {

            $('#importFileInput').on('change', function () {
                if (this.files && this.files.length) uploadImportFile(this.files[0]);
            });

            $('.catFilter').on('change', function () {
                if (!$('#catRetail').prop('checked') && !$('#catEquipment').prop('checked')) {
                    $(this).prop('checked', true);
                    Swal.fire({ toast: true, position: 'top', icon: 'info', title: 'At least one category must be selected', showConfirmButton: false, timer: 1800 });
                    return;
                }
                applyGridFilters();
            });

            clearanceDataSource = new kendo.data.DataSource({
                transport: {
                    read: {
                        url: '@Url.Action("GetWebClearance", "ClearanceSale")',
                        dataType: "json"
                    },
                    update: {
                        url: '@Url.Action("UpdateWebClearance", "ClearanceSale")',
                        type: "POST",
                        dataType: "json"
                    },
                    create: {
                        url: '@Url.Action("CreateWebClearance", "ClearanceSale")',
                        type: "POST",
                        dataType: "json"
                    },
                    destroy: {
                        url: '@Url.Action("DeleteWebClearance", "ClearanceSale")',
                        type: "POST",
                        dataType: "json"
                    },
                    parameterMap: function (options, operation) {
                        if (operation === "update" || operation === "create" || operation === "destroy") {
                            if (operation === "update") {
                                options.originalItemNumber = editingOriginalItemNumber || options.ItemNumber;
                            }
                            return options;
                        }
                    }
                },
                requestEnd: function (e) {
                    if (e.type === "create") showNotification('success', 'Item added successfully');
                    else if (e.type === "update") showNotification('success', 'Item updated successfully');
                    else if (e.type === "destroy") showNotification('success', 'Item deleted successfully');
                },
                error: function (e) {
                    var message = 'An error occurred';
                    if (e.xhr && e.xhr.responseJSON && e.xhr.responseJSON.message) {
                        message = e.xhr.responseJSON.message;
                    }
                    showNotification('error', message);
                    this.cancelChanges();
                },
                schema: {
                    // Data verification: stamp every row with its issue codes so the
                    // data-check panel can count them and filter the grid on them
                    parse: function (response) {
                        (response || []).forEach(function (r) { r.Issues = computeIssues(r); });
                        return response;
                    },
                    model: {
                        id: "ItemNumber",
                        fields: {
                            ItemNumber: { editable: true, type: "string", validation: { required: true } },
                            CategoryID: { editable: true, type: "number", defaultValue: 1, validation: { required: true } },
                            CatalogDescription: { editable: false, type: "string" },
                            CatalogPrice: { editable: false, type: "number" },
                            InCatalog: { editable: false, type: "boolean" },
                            Issues: { editable: false, type: "string" },
                            regular_price: { editable: true, type: "number", validation: { required: true, min: 0 } }
                        }
                    }
                }
            });

            salesGrid = $("#salesGrid").kendoGrid({
                dataSource: clearanceDataSource,
                toolbar: [
                    "Refresh",
                    { name: "ImportExcel", text: "Import from Excel" },
                    { name: "ExportExcel", text: "Export to Excel" },
                    { name: "UndoImport", text: "Undo Last Import" },
                    "create",
                    "Delete Selected"
                ],
                sortable: { mode: "multiple", allowUnsort: true, showIndexes: true },
                filterable: true,
                resizable: true,
                edit: function (e) {
                    var editWindow = e.container.data("kendoWindow");
                    editWindow.setOptions({ width: 700 });
                    editWindow.center();

                    e.container.find(".k-edit-label label").css({
                        "font-weight": "600",
                        "color": "#495057",
                        "font-size": "13px"
                    });
                    e.container.find(".k-edit-field .k-textbox, .k-edit-field .k-numerictextbox, .k-edit-field .k-datepicker").css({ "width": "100%" });

                    editingOriginalItemNumber = e.model.isNew() ? "" : e.model.ItemNumber;

                    // Catalog info line under the item number
                    var infoLine = $('<div class="popup-item-info" id="popupItemInfo"></div>');
                    e.container.find('[name="ItemNumber"]').closest('.k-edit-field').append(infoLine);

                    var itemNumberInput = e.container.find('[name="ItemNumber"]');
                    itemNumberInput.on('change', function () { lookupItemInfo(e.model, e.model.isNew()); });

                    // Live price verification while editing: Reg Price must sit above the live catalog price
                    var priceWarn = $('<div class="popup-item-info" id="popupPriceWarn"></div>');
                    e.container.find('[name="regular_price"]').closest('.k-edit-field').append(priceWarn);
                    var checkPopupPrices = function () {
                        var reg = e.model.regular_price, live = e.model.CatalogPrice;
                        if (live === null || live === undefined) { priceWarn.html(''); return; }
                        if (reg === null || reg === undefined || reg === 0)
                            priceWarn.html('<i class="fa fa-info-circle"></i> Selling price is ' + money(live) + '. Enter the higher "was" price here.');
                        else if (reg <= live)
                            priceWarn.html('<i class="fa fa-exclamation-triangle info-warn"></i> Not above the selling price of ' + money(live) + ' — the website would show <strong>no saving</strong>.');
                        else {
                            var pct = (reg - live) / reg * 100;
                            priceWarn.html('<i class="fa fa-check-circle info-ok"></i> Website will show ' + money(reg) + ' → <strong>' + money(live) + '</strong> (' + pct.toFixed(0) + '% off).');
                        }
                    };
                    e.model.bind('change', checkPopupPrices);
                    checkPopupPrices();

                    if (e.model.isNew()) {
                        var addButtons = document.getElementsByClassName("k-grid-update");
                        if (addButtons.length) addButtons[0].innerHTML = '<span class="k-icon k-i-check"></span>Add';
                        var windowTitles = document.getElementsByClassName("k-window-title");
                        if (windowTitles.length) windowTitles[0].innerHTML = "Add New Item";
                    } else {
                        lookupItemInfo(e.model, false);
                    }
                },
                editable: { mode: "popup", confirmation: false },
                columns: [
                    { selectable: true, width: "40px" },
                    {
                        field: "ItemNumber",
                        title: "Item Number",
                        filterable: { multi: true, search: true },
                        template: function (dataItem) {
                            var warn = dataItem.InCatalog ? "" : ' <i class="fa fa-exclamation-triangle not-in-catalog" title="Not in the web catalog — this item does NOT appear on the website at all"></i>';
                            return '<a class="item-link" href="https://webapp.wddcho.com/Items?ItemNumber=' + encodeURIComponent(dataItem.ItemNumber) + '" target="_blank" rel="noopener" title="Open this item on the WebApp in a new tab">'
                                + esc(dataItem.ItemNumber) + '</a>' + warn;
                        },
                        attributes: { class: "grid-cell", style: "text-align: center;" }
                    },
                    {
                        field: "CategoryID",
                        title: "Category",
                        values: [
                            { text: "Retail Clearance", value: 1 },
                            { text: "Equipment Clearance", value: 2 }
                        ],
                        attributes: { class: "grid-cell", style: "text-align: center;" }
                    },
                    {
                        field: "CatalogDescription",
                        title: "Description",
                        filterable: { cell: { operator: "contains", showOperators: false } },
                        template: function (dataItem) {
                            var val = dataItem.CatalogDescription || "";
                            return '<span class="desc-cell" title="' + esc(val) + '">' + esc(val) + '</span>';
                        },
                        attributes: { class: "grid-cell" }
                    },
                    {
                        field: "regular_price",
                        title: "Reg Price (was)",
                        filterable: false,
                        headerAttributes: { title: "The 'before' price shown struck through on the website. This is the only price stored here." },
                        template: function (dataItem) {
                            if (dataItem.regular_price === null || dataItem.regular_price === undefined || dataItem.regular_price === 0)
                                return '<span class="price-missing" title="No Reg Price — the website has no was-price to show">—</span>';
                            return money(dataItem.regular_price);
                        },
                        attributes: { class: "grid-cell", style: "text-align: center;" }
                    },
                    {
                        field: "CatalogPrice",
                        title: "Sale Price (live)",
                        filterable: false,
                        headerAttributes: { title: "The item's normal catalog selling price, from the pricing system. Not stored or editable here." },
                        template: function (dataItem) {
                            if (dataItem.CatalogPrice === null || dataItem.CatalogPrice === undefined)
                                return '<span class="price-missing" title="Not in the catalog — no selling price">—</span>';
                            return '<span class="sale-live" title="The price customers actually pay, taken live from the catalog">' + money(dataItem.CatalogPrice) + '</span>';
                        },
                        attributes: { class: "grid-cell", style: "text-align: center;" }
                    },
                    {
                        title: "Customer Saves",
                        filterable: false,
                        sortable: false,
                        template: function (dataItem) {
                            var pct = discountPct(dataItem);
                            if (pct === null) return "";
                            if (pct <= 0)
                                return '<span class="disc-none" title="Reg Price is not above the selling price — the website shows no saving">no saving</span>';
                            var cls = pct > 75 ? 'disc-huge' : 'disc-ok';
                            return '<span class="' + cls + '" title="' + money(dataItem.regular_price - dataItem.CatalogPrice) + ' off">' + pct.toFixed(0) + '% off</span>';
                        },
                        attributes: { class: "grid-cell", style: "text-align: center;" }
                    },
                    {
                        command: [
                            { name: "edit", className: "btn-row-edit" },
                            { name: "customDelete", text: "Delete", click: confirmRowDelete, className: "btn-row-delete" }
                        ],
                        title: "&nbsp;",
                        width: "200px"
                    }
                ]
            }).data("kendoGrid");

            salesGrid.bind("dataBound", grid_dataBound);
            salesGrid.bind("save", grid_save);

            var refreshBtn = document.getElementsByClassName('k-grid-Refresh')[0];
            refreshBtn.innerHTML = "<span class='k-icon k-i-reload'></span> Refresh";
            $('.k-grid-ImportExcel').html('<i class="fa fa-upload"></i> Import from Excel');
            $('.k-grid-ExportExcel').html('<i class="fa fa-download"></i> Export to Excel');
            $('.k-grid-UndoImport').html('<i class="fa fa-undo"></i> Undo Last Import');

            $("#salesGrid").find(".k-grid-toolbar").on("click", ".k-grid-Refresh", function (e) {
                e.preventDefault();
                salesGrid.dataSource.read();
                if (isLogVisible) loadActivityLog();
            });
            $("#salesGrid").find(".k-grid-toolbar").on("click", ".k-grid-ImportExcel", function (e) {
                e.preventDefault();
                startImport();
            });
            $("#salesGrid").find(".k-grid-toolbar").on("click", ".k-grid-ExportExcel", function (e) {
                e.preventDefault();
                window.location = '@Url.Action("Export", "ClearanceSale")';
            });
            $("#salesGrid").find(".k-grid-toolbar").on("click", ".k-grid-UndoImport", function (e) {
                e.preventDefault();
                undoLastImport();
            });

            $("#salesGrid").find(".k-grid-toolbar").on("click", ".k-grid-DeleteSelected", function (e) {
                var checkedRows = $("#salesGrid").find("tbody input:checked");
                if (checkedRows.length === 0) {
                    Swal.fire({
                        icon: 'info',
                        title: 'No Selection',
                        text: 'Please select at least one item to delete.',
                        confirmButtonColor: '#3182ce'
                    });
                    return;
                }

                Swal.fire({
                    title: 'Confirm Bulk Delete',
                    text: 'Delete ' + checkedRows.length + ' selected item(s)?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e53e3e',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete all!',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        var itemsToDelete = [];
                        checkedRows.each(function () {
                            var row = $(this).closest('tr');
                            var dataItem = salesGrid.dataItem(row);
                            if (dataItem) itemsToDelete.push(dataItem);
                        });
                        itemsToDelete.forEach(function (item) {
                            salesGrid.dataSource.remove(item);
                        });
                        salesGrid.dataSource.sync();
                        if (isLogVisible) loadActivityLog();
                    }
                });
            });

            function lookupItemInfo(model, isNew) {
                var itemNumber = (model.ItemNumber || "").trim();
                if (!itemNumber) { $('#popupItemInfo').html(''); return; }
                $('#popupItemInfo').html('<i class="fa fa-spinner fa-spin"></i> Checking catalog…');
                $.getJSON('@Url.Action("GetItemInfo", "ClearanceSale")?itemNumber=' + encodeURIComponent(itemNumber), function (json) {
                    if (json && json.description) {
                        $('#popupItemInfo').html('<i class="fa fa-check-circle info-ok"></i> ' + esc(json.description) + ' — catalog price ' + money(json.price));
                        if (isNew && (model.regular_price === null || model.regular_price === undefined || model.regular_price === 0)) {
                            model.set("regular_price", json.price);
                        }
                    } else {
                        $('#popupItemInfo').html('<i class="fa fa-exclamation-triangle info-warn"></i> Not in the web catalog — <strong>this item will not appear on the website at all.</strong>');
                    }
                }).fail(function () {
                    $('#popupItemInfo').html('');
                });
            }

            function grid_dataBound(e) {
                var data = clearanceDataSource.data();
                var retail = 0, equipment = 0, live = 0;
                for (var i = 0; i < data.length; i++) {
                    if (data[i].CategoryID === 1) retail++;
                    else if (data[i].CategoryID === 2) equipment++;
                    if (data[i].InCatalog) live++;
                }
                var hidden = data.length - live;
                document.getElementById("salesGridTotal").innerHTML =
                    '<i class="fa fa-database"></i> <strong>' + clearanceDataSource.total() + '</strong> of ' + data.length + ' items'
                    + ' &nbsp;·&nbsp; ' + retail + ' retail, ' + equipment + ' equipment'
                    + ' &nbsp;·&nbsp; <span class="live-count" title="Only items that exist in the web catalog appear on the ordering website">'
                    + '<i class="fa fa-globe"></i> ' + live + ' live on website'
                    + (hidden > 0 ? ' (' + hidden + ' not visible)' : '') + '</span>';
                renderDataCheck();
            }

            function grid_save(e) {
                e.sender.one("dataBound", function () {
                    e.sender.dataSource.read();
                    if (isLogVisible) loadActivityLog();
                });
            }

            function confirmRowDelete(e) {
                e.preventDefault();
                var grid = $("#salesGrid").data("kendoGrid");
                var tr = $(e.currentTarget).closest("tr");
                var dataItem = grid.dataItem(tr);
                var itemNumber = dataItem.ItemNumber;

                Swal.fire({
                    title: 'Confirm Delete',
                    text: 'Remove item ' + itemNumber + ' from the clearance sale?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e53e3e',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        var currentItem = grid.dataSource.get(itemNumber);
                        if (currentItem) {
                            grid.dataSource.remove(currentItem);
                            grid.dataSource.sync();
                        }
                        if (isLogVisible) loadActivityLog();
                    }
                });
            }

        })

    </script>
}

<!-- Page Header -->
<div class="wrapper wrapper-content animated fadeInRight">

    <!-- Page Header -->
    <div class="row">
        <div class="col-12">
            <div class="page-header-banner">
                <button type="button" class="btn-doc-toggle" onclick="$('#docCard').slideToggle(150)">
                    <i class="fa fa-question-circle"></i> Show / hide guide
                </button>
                <h2>
                    <i class="fa fa-percent"></i>
                    Clearance Sale
                </h2>
                <p class="subtitle">
                    Manage the Retail &amp; Equipment clearance items shown on the ordering website — one by one, or by importing the Excel sheet
                </p>
            </div>
        </div>
    </div>

    <!-- Documentation (visible by default; Hide button collapses it) -->
    <div class="row">
        <div class="col-12">
            <div class="doc-card" id="docCard">
                <button type="button" class="btn-doc-hide" onclick="$('#docCard').slideUp(150)">
                    <i class="fa fa-times"></i> Hide this guide
                </button>
                <div class="doc-title"><i class="fa fa-question-circle"></i> How this page works</div>
                <ul>
                    <li><strong>What this manages:</strong> the <strong>Retail Clearance</strong> and <strong>Equipment Clearance</strong> items shown on the WDDC ordering website.</li>
                    <li><strong>Description &amp; Catalog Price</strong> come live from the WDDC catalog — they are not stored with the clearance item. Click any item number to open it on the WebApp in a new tab.</li>
                    <li><strong><i class="fa fa-exclamation-triangle not-in-catalog"></i> means the item is not in the web catalog — customers cannot see it.</strong> The website only lists clearance items that exist in the catalog, so these sit on the list doing nothing. Either remove them or ask for the item to be added to the catalog. The item counts on the website will always be lower than the count here by the number of these.</li>
                    <li>
                        <strong>How the two prices work — important.</strong>
                        <em>Sale Price (live)</em> is <strong>the item's normal selling price in the WDDC catalog</strong> — the same price it sells at everywhere on the website. It comes from the pricing system and is <strong>not stored or editable here</strong>. Putting an item on clearance does not discount it; the discount happens when Purchasing/Finance lowers the item's price in the pricing system.
                        <br />
                        <em>Reg Price (was)</em> is the only price this page stores. It is the higher "before" price shown struck through, and the saving the customer sees is simply the gap between the two.
                        <br />
                        So: <strong>to change what a customer pays, the item's price must be changed in the pricing system. To change the advertised saving, edit Reg Price here.</strong>
                    </li>
                    <li><strong>Edit one by one:</strong> Add new record, Edit, or Delete — or tick several rows and use Delete Selected. The item number itself can be corrected while editing (e.g. a wrong code).</li>
                    <li><strong>Import from Excel</strong> replaces the whole Retail + Equipment list with your sheet. You always get a <em>review screen</em> first — duplicates, problem rows, and items that would be removed — and <strong>nothing is saved until you click Apply Import</strong>.</li>
                    <li><strong>Export to Excel</strong> downloads the current list, and is the recommended starting point for the next import.</li>
                    <li><strong>Safety:</strong> the previous list is saved automatically before every import — <em>Undo Last Import</em> puts it back. Every change is recorded in the Activity Log at the bottom of the page.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Data check panel (filled in after the grid loads) -->
    <div class="row">
        <div class="col-12">
            <div id="dataCheck" style="display:none"></div>
        </div>
    </div>

    <input type="file" id="importFileInput" accept=".xlsx,.xlsm" style="display:none" />

    <!-- Import Review -->
    <div class="row" id="importReviewCard" style="display:none">
        <div class="col-lg-12">
            <div class="card shadow-sm imp-card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span class="card-title"><i class="fa fa-upload"></i> Review Import</span>
                    <button type="button" class="btn-imp-cancel" onclick="cancelImport()"><i class="fa fa-times"></i> Cancel</button>
                </div>
                <div class="card-body" id="importReviewBody"></div>
                <div class="imp-footer">
                    <span id="importSummaryText"></span>
                    <span id="importBlockedHint" style="display:none" class="imp-blocked"><i class="fa fa-exclamation-circle"></i> Tick "Skip these rows" above to continue</span>
                    <span style="flex:1"></span>
                    <button type="button" class="btn-imp-cancel" onclick="cancelImport()">Cancel</button>
                    <button type="button" class="btn-imp-apply" id="btnApplyImport" onclick="applyImport()"><i class="fa fa-check"></i> Apply Import</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Grid Card -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span class="grid-total-badge" id="salesGridTotal"></span>
                    <span class="cat-filters">
                        <span class="cat-filters-label">Show:</span>
                        <label><input type="checkbox" id="catRetail" class="catFilter" checked> Retail Clearance</label>
                        <label><input type="checkbox" id="catEquipment" class="catFilter" checked> Equipment Clearance</label>
                    </span>
                </div>
                <div class="card-body">
                    <div id="salesGrid"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Log Section -->
    <div class="row">
        <div class="col-12">
            <div class="log-section">
                <div class="log-header">
                    <button type="button" class="btn-toggle-log" onclick="toggleLog()">
                        <i class="fa fa-history"></i> <span id="logToggleText">Show Activity Log</span>
                    </button>
                </div>
                <div id="logContainer" style="display: none; margin-top: 15px;">
                    <div id="gridActivityLog"></div>
                </div>
            </div>
        </div>
    </div>

</div>

